# Optional LLM provider keys. Configure at least one provider in LLM_PROVIDER_ORDER.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Required by workers/reminder-agent for confirmation and signed unsubscribe tokens
# EMAIL_SECRET=your-hmac-secret-here

# Reminder subscription settings
REMINDER_CONFIRM_URL=https://bli.net/api/subscribe/confirm
REMINDER_CONTENT_URL=https://bli.net/api/data
REMINDER_FROM_EMAIL=reminders@bli.net
REMINDER_FROM_NAME=Terminal Bli Net
REMINDER_LEAD_MINUTES=30
REMINDER_SUBSCRIBE_RATE_LIMIT_PER_HOUR=5

# LLM defaults (can override)
LLM_PROVIDER_ORDER=claude,openai
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MONTHLY_SPEND_CAP=25
OPENAI_MONTHLY_SPEND_CAP=25
RATE_LIMIT_PER_HOUR=30
