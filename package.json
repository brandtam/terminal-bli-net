{
	"name": "terminal-bli-net",
	"version": "1.0.0",
	"private": true,
	"description": "A retro TV terminal where AI-powered characters host shows you can chat with",
	"author": "Brandt Milczewski <brandt@bli.dev>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/brandtam/terminal-bli-net.git"
	},
	"homepage": "https://bli.net",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "playwright test",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"lint:bots": "node scripts/lint-bots.js",
		"lint:backup": "node scripts/lint-backup-coverage.js",
		"format": "prettier --write .",
		"prepare": "husky",
		"deploy-cloudflare": "pnpm build && wrangler pages deploy .svelte-kit/cloudflare",
		"deploy-cloudflare:dry": "pnpm build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.100.1",
		"agents": "^0.0.67",
		"dompurify": "^3.4.7",
		"marked": "^18.0.4",
		"openai": "^6.39.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260531.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.49.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.1",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"prettier": "^3.4.0",
		"prettier-plugin-svelte": "^4.0.1",
		"rollup-plugin-visualizer": "^7.0.1",
		"svelte": "^5.56.0",
		"svelte-check": "^4.1.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"vitest": "^4.1.7",
		"wrangler": "^4.95.0"
	},
	"lint-staged": {
		"*.{ts,svelte,js,css,json}": [
			"prettier --write"
		],
		"*.{ts,svelte,js}": [
			"eslint --fix"
		]
	}
}
